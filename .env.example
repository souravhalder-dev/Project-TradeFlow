# ==============================================================================
# TradeFlow B2B Wholesale Marketplace - Environment Variables
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/tradeflow?schema=public"

# Authentication Development Mode:
# When true, allows instant demo logins (Buyer, Supplier, Admin) alongside real Firebase Auth.
# In production, set to false to strictly enforce live Firebase Admin token verification.
AUTH_DEV_MODE="true"

# Client Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="demo-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="tradeflow-b2b.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="tradeflow-b2b"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="tradeflow-b2b.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Firebase Admin SDK (Server-Side)
FIREBASE_ADMIN_PROJECT_ID="tradeflow-b2b"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk@tradeflow-b2b.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Payment Gateway (Stripe Sandbox / Test Mode)
STRIPE_SECRET_KEY="sk_test_tradeflow_demo_key"
STRIPE_WEBHOOK_SECRET="whsec_tradeflow_demo_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_tradeflow_demo_key"

# Email Provider (Interchangeable SMTP / Resend / SendGrid)
EMAIL_FROM="TradeFlow Marketplace <no-reply@tradeflow.local>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
